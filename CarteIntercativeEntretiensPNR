        }).addTo(map).bindPopup("<b>Axe Route Napoléon</b><br>Artère logistique de l'Ouest.");

        // Légende
        var legend = L.control({position: 'bottomright'});
        legend.onAdd = function () {
            var div = L.DomUtil.create('div', 'legend');
            div.innerHTML = `
                <b>Catégories</b><br>
                <i style="background:${colors.Producteur}" class="shape-circle"></i> Producteurs (Violet)<br>
                <i style="background:${colors.Acheteur}" class="shape-circle"></i> Acheteurs (Bleu)<br>
                <i style="background:${colors['Mixte / Hub']}" class="shape-circle"></i> Hubs (Rouge)<br><br>
                <b>Sources</b><br>
                <i style="background:#666" class="shape-circle"></i> Entretiens (Cercle)<br>
                <i style="background:#666" class="shape-diamond"></i> Questionnaires (Losange)
            `;
            return div;
        };
        legend.addTo(map);

    </script>
