    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600&family=Georgia&display=swap" rel="stylesheet">

    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: 'Georgia', serif;
            color: #405F59;
            background-color: #f3f3f3;
            overflow: hidden;
        }

        /* --- HEADER --- */
        #header {
            background-color: #405F59;
            color: white;
            padding: 15px 25px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            position: relative;
            z-index: 1000;
            height: 85px;
            box-sizing: border-box;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        #header h1 {
            font-family: 'Oswald', sans-serif;
            margin: 0;
            font-size: 20px;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        #header p {
            margin: 4px 0 0 0;
            font-size: 13px;
            color: #e2e8f0;
        }

        /* --- LAYOUT PRINCIPAL --- */
        #main-container {
            display: flex;
            height: calc(100vh - 85px);
            width: 100%;
        }

        /* --- SIDEBAR --- */
        #sidebar {
            width: 380px;
            background-color: #ffffff;
            border-right: 1px solid #d1d5db;
            display: flex;
            flex-direction: column;
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
            z-index: 500;
        }
        .sidebar-header {
            padding: 20px;
            border-bottom: 1px solid #e5e7eb;
            background-color: #f9fafb;
        }
        .sidebar-header h2 {
            font-family: 'Oswald', sans-serif;
            margin: 0 0 15px 0;
            color: #405F59;
            font-size: 16px;
            text-transform: uppercase;
        }
        .filter-group {
            margin-bottom: 10px;
        }
        .filter-label {
            font-size: 12px;
            text-transform: uppercase;
            font-weight: bold;
            color: #6b7280;
            margin-bottom: 5px;
            display: block;
        }
        .filter-select {
            width: 100%;
            padding: 8px;
            border: 1px solid #d1d5db;
            border-radius: 4px;
            font-family: 'Georgia', serif;
            font-size: 14px;
            color: #405F59;
            margin-bottom: 10px;
        }

        /* Liste des acteurs */
        #actor-list {
            flex-grow: 1;
            overflow-y: auto;
        }
        .actor-item {
            padding: 12px 20px;
            border-bottom: 1px solid #f3f4f6;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: background-color 0.2s;
        }
        .actor-item:hover {
            background-color: #f5f3ff;
        }
        .actor-badge {
            width: 12px;
            height: 12px;
            margin-right: 15px;
            flex-shrink: 0;
            border: 2px solid white;
            box-shadow: 0 0 3px rgba(0,0,0,0.2);
        }
        .badge-entretien { border-radius: 50%; }
        .badge-questionnaire { border-radius: 0; transform: rotate(45deg); }

        .actor-details {
            display: flex;
            flex-direction: column;
        }
        .actor-name {
            font-weight: bold;
            font-size: 14px;
        }
        .actor-meta {
            font-size: 12px;
            color: #6b7280;
        }

        /* --- CARTE --- */
        #map {
            flex-grow: 1;
            height: 100%;
        }
        
        .legend {
            background: white;
            padding: 12px;
            line-height: 1.4em;
            box-shadow: 0 0 15px rgba(0,0,0,0.1);
            border-radius: 8px;
            font-size: 13px;
        }
        .legend i {
            width: 14px;
            height: 14px;
            float: left;
            margin-right: 8px;
            border: 1.5px solid #fff;
            box-shadow: 0 0 2px rgba(0,0,0,0.3);
        }
        .shape-circle { border-radius: 50% !important; }
        .shape-diamond { transform: rotate(45deg); margin-left: 2px; margin-right: 10px !important; }

        .custom-popup .leaflet-popup-content-wrapper {
            border-top: 5px solid #8b5cf6;
            border-radius: 4px;
        }
        .custom-popup h3 {
            font-family: 'Oswald', sans-serif;
            margin: 0 0 5px 0;
            font-size: 16px;
            text-transform: uppercase;
        }
        .source-tag {
            display: inline-block;
            font-size: 10px;
            background: #e2e8f0;
            padding: 2px 6px;
            border-radius: 10px;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 8px;
        }
    </style>
</head>
