        // --- 3. LOGIQUE POSITIONNEMENT ET DÉCALAGE ---
        function calculateOffsets() {
            let coordsMap = {};
            actorsData.forEach(actor => {
                let key = `${actor.lat.toFixed(4)}_${actor.lng.toFixed(4)}`;
                if (!coordsMap[key]) coordsMap[key] = [];
                coordsMap[key].push(actor);
            });

            Object.values(coordsMap).forEach(group => {
                if (group.length === 1) {
                    group[0].displayLat = group[0].lat;
                    group[0].displayLng = group[0].lng;
                } else {
                    let radius = group.length > 5 ? 0.008 : 0.005; 
                    group.forEach((actor, index) => {
                        let angle = (index / group.length) * Math.PI * 2;
                        actor.displayLat = actor.lat + (radius * Math.cos(angle));
                        actor.displayLng = actor.lng + (radius * 1.3 * Math.sin(angle));
                    });
                }
            });
        }

        // --- 4. RENDU ---
        function renderActors() {
            var typeVal = document.getElementById('filter-type').value;
            var sourceVal = document.getElementById('filter-source').value;
            var listContainer = document.getElementById('actor-list');
            
            markersGroup.clearLayers();
            listContainer.innerHTML = '';

            actorsData.forEach((actor, index) => {
                if (typeVal !== 'Tous' && actor.type !== typeVal) return;
                if (sourceVal !== 'Tous' && actor.source !== sourceVal) return;

                let color = colors[actor.type];
                let isEntretien = actor.source === "Entretien";

                let marker;
                if (isEntretien) {
                    marker = L.circleMarker([actor.displayLat, actor.displayLng], {
                        radius: 8,
                        fillColor: color,
                        color: "#fff",
                        weight: 2,
                        fillOpacity: 1
                    });
                } else {
                    let icon = L.divIcon({
                        className: 'custom-div-icon',
                        html: `<div style="background-color:${color}; width:12px; height:12px; transform:rotate(45deg); border:2px solid #fff; box-shadow:0 0 3px rgba(0,0,0,0.3);"></div>`,
                        iconSize: [12, 12],
                        iconAnchor: [6, 6]
                    });
                    marker = L.marker([actor.displayLat, actor.displayLng], { icon: icon });
                }

                let popupHtml = `
                    <div class="custom-popup">
                        <span class="source-tag" style="background:${isEntretien ? '#e2e8f0' : '#fef3c7'}">${actor.source}</span>
                        <h3 style="color:${color}">${actor.name}</h3>
                        <p><strong>Commune :</strong> ${actor.village}</p>
                        <p>${actor.desc}</p>
                    </div>
                `;
                
                // Configuration du Popup pour le survol
                marker.bindPopup(popupHtml, { 
                    closeButton: false, 
                    offset: L.point(0, -5) 
                });
                
                // Interaction au passage de la souris
                marker.on('mouseover', function (e) {
                    this.openPopup();
                });
                marker.on('mouseout', function (e) {
                    this.closePopup();
                });
                
                // Le clic permet toujours de recentrer et zoomer
                marker.on('click', function(e) {
                    map.setView(e.latlng, 14);
                });

                markersGroup.addLayer(marker);
                actor.leafletMarker = marker;

                let badgeClass = isEntretien ? 'badge-entretien' : 'badge-questionnaire';
                let listItem = document.createElement('div');
                listItem.className = 'actor-item';
                listItem.onclick = () => {
                    map.setView([actor.displayLat, actor.displayLng], 14);
                    actor.leafletMarker.openPopup();
                };
                listItem.innerHTML = `
                    <div class="actor-badge ${badgeClass}" style="background-color: ${color};"></div>
                    <div class="actor-details">
                        <span class="actor-name">${actor.name}</span>
                        <span class="actor-meta">${actor.village} • ${actor.source}</span>
                    </div>
                `;
                listContainer.appendChild(listItem);
            });
        }

        // Initialisation
        calculateOffsets();
        renderActors();

        // Route Napoléon
        L.polyline([[43.660, 6.926], [43.698, 6.848], [43.731, 6.783], [43.774, 6.706]], {
